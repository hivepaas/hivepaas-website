---
// index.astro - HivePaaS Landing Page (Linear / Raycast Bento Grid Style)
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import LiveDemo from '../components/LiveDemo.astro';
import Features from '../components/Features.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Comparison from '../components/Comparison.astro';
import Alternatives from '../components/Alternatives.astro';
import Audience from '../components/Audience.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { faq } from '../data/faq';

const pageTitle = "HivePaaS — Your own Heroku, on your servers";
const pageDescription = "An open-source, self-hosted PaaS on Docker Swarm. Deploy apps, databases and functions from one VPS to a whole cluster, with SSL, backups and autoscaling built in.";
const siteUrl = "https://hivepaas.com/";
const ogImage = new URL("/og-image.png", siteUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "HivePaaS",
  url: siteUrl,
  description: pageDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  image: ogImage,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: ["https://github.com/hivepaas/hivepaas", "https://docs.hivepaas.com"],
};
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(item => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="self-hosted PaaS, Heroku alternative, open source PaaS, Docker Swarm, deploy on VPS, serverless functions, PR previews, HivePaaS" />
    <meta name="author" content="HivePaaS" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HivePaaS" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HivePaaS — Your own Heroku, on your servers." />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- What search engines read about the product -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <meta name="generator" content={Astro.generator} />

    <!-- Analytics: Umami Cloud, no cookies -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="4269eacc-43fa-4312-b218-9a555fec4c72"></script>
  </head>

  <body>
    <!-- Subtle Background Grid Overlay -->
    <div class="bg-grid-overlay"></div>

    <!-- Main Navigation Bar -->
    <Navbar />

    <!-- Main Content Flow -->
    <main>
      <Hero />
      <Showcase />
      <LiveDemo />
      <Features />
      <BentoGrid />
      <Comparison />
      <Alternatives />
      <Audience />
      <HowItWorks />
      <FAQ />
      <CTA />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Linear Mouse-Tracking Spotlight Script for Bento Cards -->
    <script>
      const cards = document.querySelectorAll<HTMLElement>('.bento-card');
      
      document.addEventListener('mousemove', (e) => {
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    </script>
  </body>
</html>
