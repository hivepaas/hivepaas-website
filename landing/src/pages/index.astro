---
// index.astro - HivePaaS Landing Page (Linear / Raycast Bento Grid Style)
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import LiveDemo from '../components/LiveDemo.astro';
import Features from '../components/Features.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Comparison from '../components/Comparison.astro';
import Alternatives from '../components/Alternatives.astro';
import Audience from '../components/Audience.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { faq } from '../data/faq';
import { SITE_URL } from '../data/site';

const pageTitle = "HivePaaS — Your own Heroku, on your servers";
const pageDescription = "An open-source, self-hosted PaaS on Docker Swarm. Deploy apps, databases and functions from one VPS to a whole cluster, with SSL, backups and autoscaling built in.";
const siteUrl = `${SITE_URL}/`;
const ogImage = new URL("/og-image.png", siteUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "HivePaaS",
  url: siteUrl,
  description: pageDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  image: ogImage,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
  sameAs: ["https://github.com/hivepaas/hivepaas", "https://docs.hivepaas.com"],
};
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(item => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  keywords="self-hosted PaaS, Heroku alternative, open source PaaS, Docker Swarm, deploy on VPS, serverless functions, PR previews, HivePaaS"
  jsonLd={[structuredData, faqData]}
>
  <Hero />
  <Showcase />
  <LiveDemo />
  <Features />
  <BentoGrid />
  <Comparison />
  <Alternatives />
  <Audience />
  <HowItWorks />
  <FAQ />
  <CTA />
</BaseLayout>
