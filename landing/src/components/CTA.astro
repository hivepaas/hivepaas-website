---
// CTA.astro - Linear / Raycast Style
---

<section class="section cta-section" id="quickstart">
  <div class="container">
    <div class="bento-card cta-bento">
      <div class="cta-spotlight"></div>
      
      <div class="bento-badge-row">
        <span class="linear-pill pill-glow-amber">
          <span class="pulse-beacon"></span>
          <span>Deploy on Your VPS in 60s</span>
        </span>
      </div>

      <h2 class="cta-title">
        Take Full Control of Your Applications <br />
        <span class="text-gradient-neon">Without the DevOps Tax.</span>
      </h2>

      <p class="cta-desc">
        100% open source, self-hosted, and free. Deploy on any server with zero vendor lock-in — 
        your containers will always belong to you.
      </p>

      <!-- Raycast-Style Terminal Box with Copy -->
      <div class="cta-command-box">
        <div class="command-bar">
          <span class="command-prefix">$</span>
          <code id="ctaInstallCmd">curl -fsSL https://get.hivepaas.com | sh</code>
          <button class="command-copy-btn" id="ctaCopyBtn" aria-label="Copy install script">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="cta-copy-label">Copy</span>
            <span class="kbd">⌘C</span>
          </button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="cta-actions">
        <a href="https://github.com/hivepaas/hivepaas" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Star on GitHub</span>
        </a>
        <a href="https://github.com/hivepaas/hivepaas" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>Read Documentation →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding-bottom: 8rem;
  }

  .cta-bento {
    position: relative;
    padding: 4rem 2rem;
    text-align: center;
    border-radius: 24px;
    align-items: center;
    border: 1px solid rgba(245, 158, 11, 0.35);
    background: linear-gradient(180deg, rgba(14, 18, 28, 0.9) 0%, rgba(6, 8, 12, 0.98) 100%);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.9), 0 0 50px -10px rgba(245, 158, 11, 0.15);
  }

  .cta-spotlight {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.25), transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .cta-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    max-width: 780px;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 3.25rem;
    }
  }

  .cta-desc {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 620px;
    margin-bottom: 2.5rem;
  }

  .cta-command-box {
    width: 100%;
    max-width: 580px;
    margin-bottom: 2.5rem;
  }

  .command-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: #040508;
    border: 1px solid var(--border-card);
    border-radius: 14px;
    padding: 0.6rem 0.85rem 0.6rem 1.15rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
  }

  .command-prefix {
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .command-bar code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: nowrap;
  }

  .command-copy-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: var(--accent-amber-light);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-sans);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .command-copy-btn:hover {
    background: var(--accent-amber);
    color: #030407;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
</style>

<script>
  const ctaCopyBtn = document.getElementById('ctaCopyBtn');
  const ctaInstallCmd = document.getElementById('ctaInstallCmd');

  if (ctaCopyBtn && ctaInstallCmd) {
    ctaCopyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(ctaInstallCmd.textContent || '').then(() => {
        const label = ctaCopyBtn.querySelector('.cta-copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        }
      });
    });
  }
</script>
