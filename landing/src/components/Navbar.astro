      <div class="nav-links">
        <a href="#demo" class="nav-link">Live Demo</a>
        <a href="#bento" class="nav-link">Features</a>
        <a href="#zero-lockin" class="nav-link">Zero Lock-in</a>
        <a href="#comparison" class="nav-link">Comparison</a>
        <a href="#audience" class="nav-link">Who It's For</a>
        <a href="#how-it-works" class="nav-link">How It Works</a>
