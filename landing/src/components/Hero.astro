---
// Hero.astro - Linear / Raycast Style
---

<section class="hero-section">
  <!-- Ambient Spotlight Glow -->
  <div class="hero-spotlight"></div>

  <div class="container">
    <div class="hero-content">
      <!-- Top Linear Pill Badge -->
      <div class="hero-badge-row">
        <span class="linear-pill pill-glow-amber">
          <span class="pulse-beacon"></span>
          <span>100% Open Source & Self-Hosted</span>
        </span>
        <span class="linear-pill pill-glow-purple">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.8L19.2 8 12 11.2 4.8 8 12 4.8z"/>
          </svg>
          <span>Native Docker Swarm Cluster</span>
        </span>
      </div>

      <!-- Headline -->
      <h1 class="hero-title">
        Deploy Apps at Lightning Speed. <br />
        <span class="text-gradient-neon">Zero Vendor Lock-in.</span>
      </h1>

      <!-- Subheadline -->
      <p class="hero-subtitle">
        The lightweight self-hosted PaaS engineered on Docker Swarm. 
        Your data stays 100% on your servers. If you ever uninstall HivePaaS, 
        <strong>all your applications continue running seamlessly without downtime.</strong>
      </p>

      <!-- Raycast-Style 1-Line Install Command Box -->
      <div class="hero-command-box">
        <div class="command-bar">
          <div class="command-prefix">
            <span class="terminal-symbol">$</span>
          </div>
          <code id="heroInstallCmd">curl -fsSL https://get.hivepaas.com | sh</code>
          <button class="command-copy-btn" id="heroCopyBtn" aria-label="Copy install script">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-label">Copy</span>
            <span class="kbd">⌘C</span>
          </button>
        </div>
        <div class="command-hints">
          <span>⚡ 60-Second Install on Ubuntu/Debian/Alpine</span>
          <span>•</span>
          <span>🛡️ Runs on 1GB - 2GB VPS (&lt;200MB Baseline RAM)</span>
        </div>
      </div>

      <!-- Hero Actions -->
      <div class="hero-actions">
        <a href="#quickstart" class="btn btn-primary">
          <span>Get Started in 1 Minute</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="https://github.com/hivepaas/hivepaas" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Explore Source</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(var(--header-height) + 4.5rem);
    padding-bottom: 6rem;
    overflow: hidden;
  }

  .hero-spotlight {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 400px;
    background: radial-gradient(circle at 50% 30%, rgba(245, 158, 11, 0.15), rgba(139, 92, 246, 0.08) 50%, transparent 70%);
    filter: blur(70px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .pulse-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-amber);
    box-shadow: 0 0 10px var(--accent-amber);
    animation: beacon 2s infinite ease-in-out;
  }

  @keyframes beacon {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.8); }
  }

  .hero-title {
    font-size: 2.85rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    max-width: 940px;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4.25rem;
    }
  }

  .hero-subtitle {
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 780px;
    margin-bottom: 2.5rem;
  }

  .hero-subtitle strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Raycast Command Bar */
  .hero-command-box {
    width: 100%;
    max-width: 580px;
    margin-bottom: 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .command-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: rgba(12, 16, 24, 0.9);
    border: 1px solid var(--border-card);
    border-radius: 14px;
    padding: 0.6rem 0.85rem 0.6rem 1.15rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transition: border-color 0.2s ease;
  }

  .command-bar:hover {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .command-prefix {
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .command-bar code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: nowrap;
    user-select: all;
  }

  .command-copy-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-sans);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .command-copy-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .command-hints {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>

<script>
  const copyBtn = document.getElementById('heroCopyBtn');
  const installCmd = document.getElementById('heroInstallCmd');

  if (copyBtn && installCmd) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(installCmd.textContent || '').then(() => {
        const label = copyBtn.querySelector('.copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        }
      });
    });
  }
</script>
