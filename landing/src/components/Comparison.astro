---
// Comparison.astro - Linear / Raycast Style (Honest & Transparent Matrix)
---

<section class="section comparison-section" id="comparison">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">Direct Comparison</span>
      <h2 class="section-title">An Honest Architectural Comparison</h2>
      <p class="section-desc">
        We believe in engineering transparency. Here is how HivePaaS compares to Kubernetes and Cloud PaaS — 
        including where each solution excels.
      </p>
    </div>

    <!-- Linear Table Wrapper -->
    <div class="table-container bento-card">
      <table class="linear-table">
        <thead>
          <tr>
            <th class="th-feature">Platform Capability</th>
            <th class="th-hivepaas">
              <div class="brand-th">
                <span class="brand-th-name">HivePaaS</span>
                <span class="brand-th-tag">Self-Hosted Swarm</span>
              </div>
            </th>
            <th class="th-other">
              <div class="other-th">
                <span>Kubernetes (K8s)</span>
                <span class="other-th-tag">Enterprise Cluster</span>
              </div>
            </th>
            <th class="th-other">
              <div class="other-th">
                <span>Cloud PaaS</span>
                <span class="other-th-tag">Heroku / Render</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1: Target Cluster Scale -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Target Cluster Scale</div>
              <div class="feat-sub">Optimal cluster size without orchestration bloat</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">1 – 50 Nodes (SMB Sweet Spot)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-highlight">🏆 1,000+ Nodes (Hyperscale)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-warn">⚠ Tier-Limited</span>
            </td>
          </tr>

          <!-- Row 2: DevOps Overhead -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">DevOps Skill Overhead</div>
              <div class="feat-sub">Specialist expertise required to operate</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Zero Specialist Required</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ Very Steep (K8s / SRE Team)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Zero DevOps</span>
            </td>
          </tr>

          <!-- Row 3: Base Memory Overhead -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Idle Memory Overhead</div>
              <div class="feat-sub">RAM consumed by control plane at 0 load</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ &lt; 200 MB RAM</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ 1.2 – 1.5 GB RAM (Master)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-warn">⚠ Tier-Dependent</span>
            </td>
          </tr>

          <!-- Row 4: Monthly Infrastructure Cost -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Entry Infrastructure Cost</div>
              <div class="feat-sub">Minimum monthly server budget</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ $5 – $20 / mo (Cheap VPS)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ $70+ / mo (Control Plane)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ $25 – $200+ / mo</span>
            </td>
          </tr>

          <!-- Row 5: Ecosystem & Extensibility -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Ecosystem &amp; Extensibility</div>
              <div class="feat-sub">Available plugins, CRDs, and integrations</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-warn">Docker Compose &amp; Stacks</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-highlight">🏆 Massive (CNCF &amp; CRDs)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ Proprietary Marketplace</span>
            </td>
          </tr>

          <!-- Row 6: Multi-Cloud Auto-scaling -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Cluster Node Autoscaling</div>
              <div class="feat-sub">Automated provisioning of new cloud VPS</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-warn">1-Click / Manual Node Join</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Native Cluster Autoscaler</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-warn">⚠ Fully Automated ($$$)</span>
            </td>
          </tr>

          <!-- Row 7: Data Sovereignty -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">100% Data Sovereignty</div>
              <div class="feat-sub">Customer databases strictly on your own servers</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Full Privacy &amp; Control</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Full Privacy &amp; Control</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ Proprietary Cloud Vault</span>
            </td>
          </tr>

          <!-- Row 8: Zero Vendor Lock-in -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Zero Vendor Lock-in</div>
              <div class="feat-sub">Apps continue running if PaaS is uninstalled</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Autonomous Swarm Mesh</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-warn">⚠ Requires K8s Runtime</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ 100% Proprietary Lock-in</span>
            </td>
          </tr>

          <!-- Row 9: Ephemeral PR Previews -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Ephemeral App Previews</div>
              <div class="feat-sub">Automated preview URLs for every Git PR</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Built-In Free</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-warn">⚠ Complex CI Setup</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Paid Plans Only</span>
            </td>
          </tr>

          <!-- Row 10: Open Source Freedom -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Open Source Freedom</div>
              <div class="feat-sub">Source code access &amp; self-hosting rights</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ 100% Open Source</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Open Source</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-fail">✗ Closed Commercial</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    position: relative;
  }

  .table-container {
    padding: 0;
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--border-card);
  }

  .linear-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
    text-align: left;
  }

  .linear-table th,
  .linear-table td {
    padding: 1.15rem 1.4rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .linear-table thead th {
    background: rgba(12, 16, 24, 0.95);
  }

  .th-feature { width: 33%; font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; }
  
  .th-hivepaas {
    width: 27%;
    background: rgba(245, 158, 11, 0.08) !important;
    border-left: 1px solid rgba(245, 158, 11, 0.25);
    border-right: 1px solid rgba(245, 158, 11, 0.25);
  }

  .th-other { width: 20%; }

  .brand-th {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .brand-th-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-amber-light);
  }

  .brand-th-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .other-th {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .other-th-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .td-feature {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .feat-name {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .feat-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .td-hivepaas {
    background: rgba(245, 158, 11, 0.03);
    border-left: 1px solid rgba(245, 158, 11, 0.25);
    border-right: 1px solid rgba(245, 158, 11, 0.25);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .status-pass { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .status-warn { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
  .status-fail { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  .status-highlight { background: rgba(139, 92, 246, 0.18); color: #c084fc; border: 1px solid rgba(139, 92, 246, 0.35); }
</style>
