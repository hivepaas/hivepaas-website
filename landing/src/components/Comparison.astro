---
// Comparison.astro - Linear / Raycast Style (Honest & Transparent Matrix)
---

<section class="section comparison-section" id="comparison">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">Comparison</span>
      <h2 class="section-title">The right tool for the job</h2>
      <p class="section-desc">
        Kubernetes and managed cloud platforms are excellent at what they are built for. Here is how HivePaaS
        compares — including where each of them is the better choice.
      </p>
    </div>

    <!-- Linear Table Wrapper -->
    <div class="table-container bento-card">
      <table class="linear-table">
        <thead>
          <tr>
            <th class="th-feature">Platform Capability</th>
            <th class="th-hivepaas">
              <div class="brand-th">
                <span class="brand-th-name">HivePaaS</span>
                <span class="brand-th-tag">Self-Hosted Swarm</span>
              </div>
            </th>
            <th class="th-other">
              <div class="other-th">
                <span>Kubernetes (K8s)</span>
                <span class="other-th-tag">Enterprise Cluster</span>
              </div>
            </th>
            <th class="th-other">
              <div class="other-th">
                <span>Cloud PaaS</span>
                <span class="other-th-tag">Heroku / Render</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1: Target Cluster Scale -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Target Cluster Scale</div>
              <div class="feat-sub">The cluster size each is designed for</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">1 – 50 Nodes (SMB Sweet Spot)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-highlight">🏆 1,000+ Nodes (Hyperscale)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Set by your plan</span>
            </td>
          </tr>

          <!-- Row 2: DevOps Overhead -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Operating Effort</div>
              <div class="feat-sub">Expertise needed to operate it</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ No specialist needed</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">A platform team is typical</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Fully managed for you</span>
            </td>
          </tr>

          <!-- Row 3: Base Memory Overhead -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Idle Memory Overhead</div>
              <div class="feat-sub">RAM consumed by control plane at 0 load</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ ~300 MB RAM</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">~1 GB+ (control plane, typical)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Managed by the provider</span>
            </td>
          </tr>

          <!-- Row 4: Monthly Infrastructure Cost -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Entry Infrastructure Cost</div>
              <div class="feat-sub">Minimum monthly server budget</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Any VPS, from ~$5 / mo</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Varies by distribution / cloud</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Usage-based plans</span>
            </td>
          </tr>

          <!-- Row 5: Ecosystem & Extensibility -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Ecosystem &amp; Extensibility</div>
              <div class="feat-sub">What you can run and plug in</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Any Docker image + 300+ templates</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-highlight">🏆 Massive (CNCF &amp; CRDs)</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Curated add-on marketplace</span>
            </td>
          </tr>

          <!-- Row 6: Multi-Cloud Auto-scaling -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Cluster Node Autoscaling</div>
              <div class="feat-sub">Adding servers as the load grows</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-neutral">Join a node with one command</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Native Cluster Autoscaler</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Handled by the provider</span>
            </td>
          </tr>

          <!-- Row 7: Data Sovereignty -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Data Sovereignty</div>
              <div class="feat-sub">Customer databases strictly on your own servers</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Full Privacy &amp; Control</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Full Privacy &amp; Control</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">In the provider's cloud</span>
            </td>
          </tr>

          <!-- Row 8: Zero Vendor Lock-in -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Portability</div>
              <div class="feat-sub">What your apps run on underneath</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Plain Swarm services</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Standard K8s resources</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Runs on the provider's platform</span>
            </td>
          </tr>

          <!-- Row 9: Ephemeral PR Previews -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Ephemeral App Previews</div>
              <div class="feat-sub">Automated preview URLs for every Git PR</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Built in</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Through CI or add-on tools</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Built in</span>
            </td>
          </tr>

          <!-- Row 10: Open Source Freedom -->
          <tr>
            <td class="td-feature">
              <div class="feat-name">Open Source Freedom</div>
              <div class="feat-sub">Source code access &amp; self-hosting rights</div>
            </td>
            <td class="td-hivepaas">
              <span class="status-pill status-pass">✓ Open Source</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-pass">✓ Open Source</span>
            </td>
            <td class="td-other">
              <span class="status-pill status-neutral">Commercial service</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    position: relative;
  }

  .table-container {
    padding: 0;
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--border-card);
  }

  .linear-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
    text-align: left;
  }

  .linear-table th,
  .linear-table td {
    padding: 1.15rem 1.4rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .linear-table thead th {
    background: rgba(12, 16, 24, 0.95);
  }

  .th-feature { width: 33%; font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; }
  
  .th-hivepaas {
    width: 27%;
    background: rgba(245, 158, 11, 0.08) !important;
    border-left: 1px solid rgba(245, 158, 11, 0.25);
    border-right: 1px solid rgba(245, 158, 11, 0.25);
  }

  .th-other { width: 20%; }

  .brand-th {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .brand-th-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-amber-light);
  }

  .brand-th-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .other-th {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .other-th-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .td-feature {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .feat-name {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .feat-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .td-hivepaas {
    background: rgba(245, 158, 11, 0.03);
    border-left: 1px solid rgba(245, 158, 11, 0.25);
    border-right: 1px solid rgba(245, 158, 11, 0.25);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .status-pass { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .status-warn { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
  .status-neutral { background: rgba(148, 163, 184, 0.1); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.25); }
  .status-highlight { background: rgba(139, 92, 246, 0.18); color: #c084fc; border: 1px solid rgba(139, 92, 246, 0.35); }
</style>
