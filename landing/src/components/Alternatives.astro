---
// Alternatives.astro - HivePaaS among the other open-source, self-hosted PaaS

const projects = [
  {
    name: 'Coolify',
    href: 'https://coolify.io',
    text: 'A popular, feature-rich self-hosted PaaS with a large, active community and a big catalog of one-click services.',
  },
  {
    name: 'Dokploy',
    href: 'https://dokploy.com',
    text: 'A modern, clean self-hosted PaaS with first-class Docker Compose support and multi-server deployments.',
  },
  {
    name: 'CapRover',
    href: 'https://caprover.com',
    text: 'A mature, battle-tested PaaS on Docker Swarm, simple to run and trusted by many teams for years.',
  },
];

const focus = [
  'Functions next to your apps: Node.js & TypeScript, Bun, Python and Go',
  'Autoscaling on requests or CPU, and request metrics measured by eBPF',
  'Projects with their own environments, and access per project and per module',
  'Encrypted, deduplicated backups with Kopia, to S3-compatible storage',
  'An MCP server, so AI assistants can work with your cluster safely',
  'Apps that keep running even when HivePaaS itself is stopped',
];
---

<section class="section alternatives-section" id="alternatives">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Good Company</span>
      <h2 class="section-title">Choosing a self-hosted PaaS</h2>
      <p class="section-desc">
        Self-hosting has a great open-source community, and HivePaaS is glad to be part of it. These projects are
        excellent too — try them, and pick the one that fits the way you work.
      </p>
    </div>

    <div class="alt-grid">
      {projects.map(p => (
        <a class="bento-card alt-card" href={p.href} target="_blank" rel="noopener noreferrer">
          <span class="alt-name">{p.name} <span aria-hidden="true">↗</span></span>
          <span class="alt-text">{p.text}</span>
        </a>
      ))}
    </div>

    <div class="bento-card focus-card">
      <h3 class="focus-title">Where HivePaaS puts its focus</h3>
      <ul class="focus-list">
        {focus.map(f => <li>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .alt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 800px) {
    .alt-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .alt-card {
    padding: var(--card-pad);
    gap: 0.6rem;
    text-decoration: none;
  }

  .alt-name {
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--text-primary);
  }

  .alt-name span {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .alt-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .focus-card {
    padding: var(--card-pad);
    border-color: rgba(245, 158, 11, 0.3);
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.06) 0%, var(--bg-card) 100%);
  }

  .focus-title {
    font-size: 1.25rem;
    font-weight: 750;
    color: var(--accent-amber-light);
    margin-bottom: 1.1rem;
  }

  .focus-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem 2rem;
  }

  @media (min-width: 800px) {
    .focus-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .focus-list li {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-secondary);
    padding-left: 1.4rem;
    position: relative;
  }

  .focus-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #34d399;
    font-weight: 700;
  }
</style>
