---
// Features.astro - what HivePaaS does, each with its docs page

const docs = 'https://docs.hivepaas.com';

const features = [
  {
    icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
    tone: 'amber',
    title: 'Functions',
    text: 'Write a handler, not a server. HivePaaS builds it on its runtime and calls it once per request — over HTTPS, inside the project, or on a schedule.',
    bullets: ['Node.js & TypeScript, Bun, Python, Go', 'Edit and run in the browser, or build from Git', 'Scales on its calls'],
    href: `${docs}/deploying-apps/functions`,
  },
  {
    icon: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
    tone: 'purple',
    title: 'App Store, 300+ templates',
    text: 'PostgreSQL, Redis, WordPress, n8n, Grafana, Ollama and hundreds more. A template knows its image, storage, health check and the apps it needs.',
    bullets: ['Databases, CMSs, analytics, AI tools', 'Parameters with sensible defaults', 'Versions you pick'],
    href: `${docs}/deploying-apps/app-store`,
  },
  {
    icon: 'M21 12a9 9 0 1 1-3-6.7M21 4v5h-5',
    tone: 'emerald',
    title: 'Backups you can restore',
    text: 'Volumes and databases backed up on a schedule with Kopia: encrypted, deduplicated and compressed, so a daily backup of a large volume stays small.',
    bullets: ['AWS S3, Cloudflare R2, Backblaze B2, MinIO', 'Or a volume on one of your nodes', 'Restore from the dashboard'],
    href: `${docs}/backups/backup-repositories`,
  },
  {
    icon: 'M3 3v18h18M7 15l4-4 3 3 6-6',
    tone: 'cyan',
    title: 'Autoscale & metrics',
    text: 'Replicas follow the load — requests, CPU or both — between the limits you set. Requests, errors and latency are measured by eBPF on the node, with no SDK in your code.',
    bullets: ['Checks the load every 15 seconds', 'Up to 50 replicas per app', 'Per-path and per-call metrics'],
    href: `${docs}/configuring-apps/resources-and-placement#autoscale`,
  },
  {
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
    tone: 'blue',
    title: 'Domains & SSL',
    text: "Point a domain at your server and HivePaaS routes it through Traefik, with Let's Encrypt certificates issued and renewed on their own.",
    bullets: ['Wildcard certificates through your DNS provider', 'Redirects, rate limits, basic auth, allowed IPs', 'Bring your own certificate'],
    href: `${docs}/domains-and-tls/app-domains`,
  },
  {
    icon: 'M12 8V4H8M4 12h16M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM9 15h.01M15 15h.01',
    tone: 'gold',
    title: 'AI assistants, through MCP',
    text: 'Let Claude, Codex, Gemini, Cursor or Copilot find out why an app is down, read its logs, or install an app — within what its API key may do.',
    bullets: ['Read-only unless you allow changes', 'Shows every change before making it', 'Never deletes anything'],
    href: `${docs}/integrations/mcp-server`,
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">What You Get</span>
      <h2 class="section-title">Everything an app needs in production</h2>
      <p class="section-desc">
        Deployments, previews, logs and terminals are the start. These are the parts teams usually have to bolt on
        themselves — in HivePaaS they come built in.
      </p>
    </div>

    <div class="features-grid">
      {features.map(f => (
        <article class={`bento-card feature-card tone-${f.tone}`}>
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={f.icon}></path>
            </svg>
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-text">{f.text}</p>
          <ul class="feature-bullets">
            {f.bullets.map(b => <li>{b}</li>)}
          </ul>
          <a class="feature-link" href={f.href} target="_blank" rel="noopener noreferrer">Read the docs →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    padding: var(--card-pad);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.35rem;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone) 32%, transparent);
  }

  .tone-amber { --tone: var(--accent-amber); }
  .tone-purple { --tone: #c084fc; }
  .tone-emerald { --tone: #34d399; }
  .tone-cyan { --tone: var(--accent-cyan); }
  .tone-blue { --tone: #60a5fa; }
  .tone-gold { --tone: #fbbf24; }

  .feature-title {
    font-size: 1.3rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .feature-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .feature-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    margin-bottom: 1.25rem;
  }

  .feature-bullets li {
    font-size: 0.86rem;
    color: var(--text-secondary);
    opacity: 0.85;
  }

  .feature-bullets li::before {
    content: '✓ ';
    color: var(--tone);
  }

  .feature-link {
    position: relative;
    z-index: 2;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-amber-light);
    text-decoration: none;
  }

  .feature-link:hover {
    text-decoration: underline;
  }
</style>
